# /srv/apps/.env  — copy from env.example and fill in. Never commit the real one.
#
# This is the only file a student edits per-VM. The Caddyfile, the compose file
# and the scripts are identical for everyone.

DEBUG=False
SECRET_KEY=change-me-to-something-long-and-random

# Where Let's Encrypt sends expiry warnings.
ACME_EMAIL=you@example.com

# --- Hostnames -------------------------------------------------------------
# One per app. Each must resolve to this VM's static IP — a single wildcard
# A record (*.yourdomain.dev -> the IP) covers all of them at once.
LOCALLIBRARY_HOST=library.yourdomain.dev
KAHDUKE_HOST=kahduke.yourdomain.dev
FINAL_PROJECT_HOST=finalproject.yourdomain.dev

# A leading dot means "this domain and any subdomain of it", so one entry
# covers every app you will ever add.
ALLOWED_HOSTS=.yourdomain.dev

# Django 4.0+ accepts a wildcard here, so this also needs no maintenance.
# Entries must carry the scheme; with Caddy on 443 there is no port to add.
CSRF_TRUSTED_ORIGINS=https://*.yourdomain.dev

# --- Database --------------------------------------------------------------
# Credentials for the Postgres container. docker-compose.yml builds each app's
# DATABASE_URL from these, pointing at a different database per app, so this is
# the only place the password appears.
#
# Note these are read by Compose itself (${...} interpolation), not just passed
# through to containers — which is why they live here rather than in the
# compose file.
POSTGRES_USER=cs347
POSTGRES_PASSWORD=change-me-too

# Deliberately NOT set here: DATABASE_URL. Leaving it unset locally is what
# makes settings.py fall back to SQLite on a student's laptop.

# ---------------------------------------------------------------------------
# Two settings.py lines are required alongside this, in every app —
# see settings-snippet.py:
#
#     DATABASES = {"default": dj_database_url.config(default=f"sqlite:///...")}
#     SECURE_PROXY_SSL_HEADER = ("HTTP_X_FORWARDED_PROTO", "https")
# ---------------------------------------------------------------------------
